{
  "name": "agentic-os-v3",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "NEXUS 2.0 / Agentic OS V3 - Universal AI Agent Operating System",
  "license": "Apache-2.0",
  "author": "Warzonesiddiki",
  "scripts": {
    "dev": "cd server && npm run dev",
    "dev:frontend": "vite",
    "build": "cd server && npm run build",
    "build:frontend": "vite build",
    "build:standalone": "vite build --config vite.config.standalone.ts",
    "test": "cd server && npm test",
    "test:watch": "cd server && npm run test:watch",
    "test:integration": "cd server && npm run test:integration",
    "lint": "cd server && npm run lint",
    "typecheck": "cd server && npm run typecheck",
    "validate": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write '**/*.{ts,tsx,json,yaml,yml,md,css}'",
    "clean": "pnpm -r exec -- rm -rf dist coverage *.tsbuildinfo",
    "test:rust": "cargo test --workspace",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-virtual": "^3.14.5",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "hash-wasm": "^4.12.0",
    "jotai": "^2.10.0",
    "motion": "^12.42.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.17.0",
    "eslint-formatter-compact": "^9.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.3",
    "tsx": "^4.19",
    "typescript": "^5.8",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.1"
  },
  "engines": {
    "node": "^22.x"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.7",
      "@hono/node-server": "^2.1.6",
      "ip-address": "^10.7.4",
      "proxy-addr": "^2.0.8",
      "browserslist": "^4.28.7",
      "body-parser": "^2.4.0",
      "hono": "^4.13.16",
      "qs": "^6.16.1"
    }
  },
  "packageManager": "pnpm@9.15.0"
}
